// Prisma schema — Network Engineer Virtual Lab
// Provider: PostgreSQL (instance LOKAL agar aplikasi tetap jalan offline).
// Jangan pakai cloud DB (Supabase/Neon/dll) — syaratnya offline-first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Progress per sub-bab per part.
// Satu baris per (partId, subbab) yang pernah disentuh user.
// partId: '01'..'39' (lihat PART_ORDER di lib/parts/types.ts)
// subbab: id sub-bab, mis. "2.1"
model SubbabProgress {
  partId    String
  subbab    String
  passed    Boolean  @default(false)
  answers   Json? // {"0": 2, "1": 0} — qIdx -> optIdx jawaban quiz yang dipilih
  updatedAt DateTime @updatedAt

  @@id([partId, subbab])
  @@map("subbab_progress")
}

// Key-value kecil, mis. key="current:02" -> id sub-bab terakhir dibuka di Part 02.
model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_meta")
}
